# SportNexus Environment Variables Template
VITE_API_BASE_URL=https://sep490-sportnexus-be.onrender.com
VITE_APP_NAME=SportNexus
# Fill with verified backend role names mapped to /dashboard or /admin/dashboard.
VITE_AUTH_ROLE_ROUTES={"Admin":"/admin/dashboard","Player":"/dashboard"}
VITE_ALLOW_MOCK_AUTH=true
# Đăng nhập Google / Facebook (giá trị công khai, phải trùng cấu hình BE trên Render)
# VITE_GOOGLE_CLIENT_ID = Auth:Google:ClientIds (OAuth Client ID loại "Web application")
VITE_GOOGLE_CLIENT_ID=
# VITE_FACEBOOK_APP_ID = Auth:Facebook:AppId (KHÔNG đưa AppSecret vào FE)
VITE_FACEBOOK_APP_ID=
