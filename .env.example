# SportNexus Environment Variables Template
VITE_API_BASE_URL=https://sep490-sportnexus-be.onrender.com
VITE_APP_NAME=SportNexus
# Fill with verified backend role names mapped to /dashboard or /admin/dashboard.
VITE_AUTH_ROLE_ROUTES={"Admin":"/admin/dashboard","Player":"/dashboard"}
VITE_ALLOW_MOCK_AUTH=true
# Đăng nhập Google / Facebook (giá trị công khai, phải trùng cấu hình BE trên Render)
# VITE_GOOGLE_CLIENT_ID = Auth:Google:ClientIds (OAuth Client ID loại "Web application")
VITE_GOOGLE_CLIENT_ID=
# VITE_FACEBOOK_APP_ID = Auth:Facebook:AppId (KHÔNG đưa AppSecret vào FE)
VITE_FACEBOOK_APP_ID=
# Firebase Phone Auth (OTP qua SMS thật, cùng project Firebase với app mobile / BE).
# Lấy ở Firebase Console > Project settings > Your apps > Web app. Bật Phone provider và thêm domain web vào Authorized domains.
# Để trống → web dùng luồng OTP cũ /api/auth/send-otp (không gửi SMS, chỉ dùng khi dev với devOtp).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Bản đồ & Geocoding (để trống → dùng OpenStreetMap Standard + Esri World Imagery hợp lệ)
# VITE_MAPTILER_API_KEY=
# VITE_MAPBOX_ACCESS_TOKEN=
# Proxy Backend cho Nominatim (khuyến khích khi BE hỗ trợ GET /search?q=... & GET /reverse?lat=...&lon=...):
# Vd: /api/v1/locations (tương đối theo VITE_API_BASE_URL) hoặc URL đầy đủ
VITE_GEOCODE_PROXY_URL=
# Chế độ test giải đấu: nới luật ngày để test trọn luồng trong ~15 phút (dev hoặc Vercel Preview, KHÔNG đặt cho Production).
# Xem docs/test-giai-dau-nhanh.md. Đặt true khi test, xóa rồi build lại trước khi demo.
VITE_TOURNAMENT_TEST_RULES=false
